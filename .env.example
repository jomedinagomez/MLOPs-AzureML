# Copy this file to .env and provide values for your Azure ML environment.
# The .env file is ignored by Git and must not be committed or shared.

# Azure account and workspace
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=
AZUREML_WORKSPACE_NAME=

# SDK pipeline submission notebook
AZUREML_PIPELINE_FILE=pipelines/single-step-merge-job.yaml
RUN_AZUREML_JOB=false

# Shared model asset
AZUREML_MODEL_NAME=taxi-fare-h2o-binary
AZUREML_MODEL_VERSION=1

# Notebooks 01-02: optional model registration
REGISTER_IN_AZURE=false

# Notebook 04: managed online endpoint
DEPLOY_TO_AZURE=false
PROMOTE_TRAFFIC_AFTER_VALIDATION=false
DELETE_ENDPOINT_AFTER_TEST=false
AZUREML_ONLINE_ENDPOINT_NAME=h2o-taxi-endpoint
AZUREML_ONLINE_DEPLOYMENT_NAME=blue
AZUREML_ONLINE_ENDPOINT_IDENTITY_ID=
AZUREML_ONLINE_INSTANCE_TYPE=Standard_DS3_v2

# Notebook 05: batch scoring pipeline and schedule
SUBMIT_TO_AZURE=false
CREATE_TEST_SCHEDULE=false
DISABLE_SCHEDULE_AFTER_TEST=true
DELETE_SCHEDULE_AFTER_TEST=false
AZUREML_COMPUTE_NAME=
AZUREML_COMPUTE_IDENTITY_CLIENT_ID=
AZUREML_OUTPUT_DATASTORE=
AZUREML_BATCH_EXPERIMENT_NAME=h2o-binary-batch-scoring
AZUREML_BATCH_SCHEDULE_NAME=h2o-taxi-batch-test-schedule
