# Copy to .env. Resource coordinates and authentication choice only; no credentials.
# Select a workspace/registry and optional cluster without changing notebook code.
# Operations run directly when their notebook cells execute; no enable flags are needed.
AZURE_SUBSCRIPTION_ID=<SUBSCRIPTION_ID>
AZURE_RESOURCE_GROUP=<WORKSPACE_RESOURCE_GROUP>
AZUREML_WORKSPACE_NAME=<WORKSPACE_NAME>
AZUREML_REGISTRY_NAME=<EXISTING_REGISTRY_NAME>
# Required by command and pipeline job notebooks.
AZUREML_COMPUTE_NAME=
# Cluster identity Client ID, not Principal ID; no identity lookup in job notebooks.
AZUREML_COMPUTE_IDENTITY_CLIENT_ID=
# true on an Azure compute instance/cluster; false locally after az login.
USE_MANAGED_IDENTITY=true
