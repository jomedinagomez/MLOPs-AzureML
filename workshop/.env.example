# Copy this file to workshop/.env and provide values for the target Azure ML workspace.
# Do not add passwords, client secrets, access keys, or tokens. The workshop uses Azure CLI authentication.

# Azure account and workspace
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
JAVA_HOME=
HADOOP_HOME=
AZURE_RESOURCE_GROUP=
AZUREML_WORKSPACE_NAME=
AZUREML_COMPUTE_NAME=
AZUREML_COMPUTE_INSTANCE_NAME=
# Client ID of the UMI assigned to the compute cluster. The compute instance
# UMI is discovered from DEFAULT_IDENTITY_CLIENT_ID at runtime.
AZUREML_COMPUTE_IDENTITY_CLIENT_ID=
AZUREML_OUTPUT_DATASTORE=workspaceblobstore
AZUREML_ONLINE_ENDPOINT_IDENTITY_ID=
AZUREML_ONLINE_INSTANCE_TYPE=Standard_DS3_v2
AZUREML_ONLINE_ENDPOINT_PUBLIC_NETWORK_ACCESS=disabled

# External AML registry. Run asset sharing from compute with private connectivity.
AZUREML_REGISTRY_NAME=
REGISTRY_ASSET_TYPES=model,environment,data
# Blank source versions resolve the latest workspace asset once.
# Blank target versions preserve that resolved source version.
REGISTRY_MODEL_SOURCE_VERSION=
REGISTRY_MODEL_TARGET_VERSION=
REGISTRY_ENVIRONMENT_SOURCE_VERSION=
REGISTRY_ENVIRONMENT_TARGET_VERSION=
REGISTRY_DATA_SOURCE_VERSION=
REGISTRY_DATA_TARGET_VERSION=

# Managed feature store demo (notebooks/07_feature_store). The notebooks use the project
# workspace subscription and resource group, as the official sample does.
AZURE_USER_OBJECT_ID=<ENTRA_OBJECT_ID>
AZUREML_FEATURE_STORE_NAME=<FEATURE_STORE_NAME>
AZUREML_FEATURE_STORE_LOCATION=northcentralus
# ADLS Gen2 account and filesystem for the sample source and observation data.
FEATURE_STORE_SOURCE_STORAGE_ACCOUNT=<ADLS_GEN2_ACCOUNT>
FEATURE_STORE_SOURCE_FILESYSTEM=spark
# Globally unique Azure Managed Redis name (online store) and region-unique online endpoint name.
FEATURE_STORE_REDIS_NAME=<MANAGED_REDIS_NAME>
FEATURE_STORE_ONLINE_ENDPOINT_NAME=<ONLINE_ENDPOINT_NAME>

# Registration notebooks omit Azure asset versions so the SDK assigns them.
# Later notebooks resolve named assets through the Azure ML latest label.
# Foundation assets
WORKSHOP_DATA_NAME=workshop-taxi-data
WORKSHOP_ENVIRONMENT_NAME=workshop-taxi-environment
WORKSHOP_MODEL_NAME=workshop-taxi-model
WORKSHOP_ENDPOINT_NAME=workshop-taxi-endpoint
WORKSHOP_DEPLOYMENT_NAME=blue
WORKSHOP_EXPERIMENT_NAME=azureml-workshop

# Foundation model data collection uses a separate deployment and environment.
WORKSHOP_DATA_COLLECTION_DEPLOYMENT_NAME=collector
WORKSHOP_DATA_COLLECTION_ENVIRONMENT_NAME=workshop-taxi-data-collection-environment
AZUREML_DATA_COLLECTION_DATASTORE=datacollection_adls
WORKSHOP_DATA_COLLECTION_SAMPLING_RATE=1.0
WORKSHOP_DATA_COLLECTION_ROLLING_RATE=hour

# Reference H2O binary-model assets
H2O_VERSION=3.46.0.12
H2O_BUNDLE_DIR=data/h2o/reference_bundle
H2O_FEATURES=vendorID,passengerCount,tripDistance,paymentType,pickupHour
H2O_CATEGORICAL_FEATURES=vendorID,paymentType
H2O_TARGET=fareAmount
H2O_MODEL_NAME=workshop-h2o-binary
# Bundle-manifest metadata; this does not select an Azure ML asset version.
H2O_MODEL_VERSION=1
H2O_ENVIRONMENT_NAME=workshop-h2o-binary-environment
H2O_ENDPOINT_NAME=workshop-h2o-endpoint
H2O_DEPLOYMENT_NAME=blue
H2O_EXPERIMENT_NAME=workshop-h2o-scoring
H2O_NTHREADS=3
H2O_MAX_MEM_SIZE=6G

# Customer H2O BYOM profile. Select "mojo" or "binary" in Cell 2 of
# 01_package_and_validate_model.ipynb. Per-profile runtime and schema values
# live in data/h2o/customer_bundle/profiles/<profile>/profile.json.
# Golden files are detected automatically when both canonical CSVs exist.
H2O_CUSTOMER_RUN_GOLDEN_VALIDATION=true
H2O_CUSTOMER_REQUIRE_GOLDEN_VALIDATION=false
# Optional batch input override. Blank uses the selected profile's golden input
# when available; a profile without golden data requires an explicit path.
H2O_CUSTOMER_SCORING_INPUT_PATH=

# Pipeline submission
H2O_CORRELATION_ID=workshop-manual-run
H2O_ID_COLUMN=__generated__
H2O_FAIL_ON_REJECTS=false

# Safety switches. Enable only the operation currently being demonstrated.
REGISTER_FOUNDATION_DATA=false
REGISTER_FOUNDATION_ENVIRONMENT=false
REGISTER_FOUNDATION_MODEL=false
SHARE_FOUNDATION_ASSETS=false
SUBMIT_FOUNDATION_JOB=false
DEPLOY_FOUNDATION_ENDPOINT=false
PROMOTE_FOUNDATION_TRAFFIC=false
DEPLOY_FOUNDATION_DATA_COLLECTION=false
PROMOTE_FOUNDATION_DATA_COLLECTION_TRAFFIC=false
RUN_SINGLE_STEP_JOB=false
RUN_INTEGRATION_PIPELINE=false
RUN_SERVERLESS_SPARK_JOB=false
TITANIC_SPARK_MODEL_NAME=workshop-titanic-spark-model
TITANIC_SPARK_STORAGE_ACCOUNT=<ADLS_GEN2_ACCOUNT>
TITANIC_SPARK_FILESYSTEM=spark
TITANIC_SPARK_MODEL_PATH=pipelines/titanic-training/model
TITANIC_SPARK_METRICS_PATH=pipelines/titanic-training/metrics
TITANIC_SPARK_VALIDATION_PATH=pipelines/titanic-training/validation
RUN_TITANIC_SPARK_PIPELINE=false
REGISTER_TITANIC_SPARK_MODEL=false
TITANIC_SPARK_MODEL_VERSION=1
RUN_TITANIC_SPARK_INFERENCE_PIPELINE=false
TITANIC_SPARK_INFERENCE_OUTPUT_PATH=pipelines/titanic-inference
# Reuse a successful inference pipeline without submitting another Spark job.
TITANIC_SPARK_INFERENCE_JOB_NAME=
# Optional previous whitespace-delimited Titanic predictions for parity checking.
TITANIC_SPARK_INFERENCE_REFERENCE_PREDICTIONS_PATH=
RUN_TITANIC_SPARK_MODEL_CONSUMPTION=false
TITANIC_SPARK_MODEL_CONSUMPTION_OUTPUT_PATH=model-consumption/titanic
TITANIC_SPARK_MODEL_CONSUMPTION_JOB_NAME=
# Optional headered predictions CSV from notebook 03 for comparison.
TITANIC_SPARK_MODEL_CONSUMPTION_REFERENCE_PREDICTIONS_PATH=
REGISTER_H2O_MODEL=false
REGISTER_H2O_ENVIRONMENT=false
DEPLOY_H2O_ENDPOINT=false
PROMOTE_H2O_TRAFFIC=false
RUN_H2O_SCORING_PIPELINE=false
CREATE_AML_SCHEDULE=false
CLEANUP_WORKSHOP_ASSETS=false
